  driver_shifts_driver_shifts_created_byTousers              driver_shifts[]         @relation("driver_shifts_created_byTousers")
  driver_shifts_driver_shifts_registered_byTousers           driver_shifts[]         @relation("driver_shifts_registered_byTousers")
  driver_shifts_driver_shifts_reviewed_byTousers             driver_shifts[]         @relation("driver_shifts_reviewed_byTousers")
  extra_fees_extra_fees_confirmed_byTousers                  extra_fees[]            @relation("extra_fees_confirmed_byTousers")
  extra_fees_extra_fees_recorded_byTousers                   extra_fees[]            @relation("extra_fees_recorded_byTousers")
  incidents_incidents_escalated_byTousers                    incidents[]             @relation("incidents_escalated_byTousers")
  incidents_incidents_resolved_byTousers                     incidents[]             @relation("incidents_resolved_byTousers")
  locations                                                  locations[]
  news_posts                                                 news_posts[]
  notifications                                              notifications[]
  order_notes                                                order_notes[]
  order_status_history                                       order_status_history[]
  orders_orders_created_byTousers                            orders[]                @relation("orders_created_byTousers")
  orders_orders_responsible_dispatcher_idTousers             orders[]                @relation("orders_responsible_dispatcher_idTousers")
  password_reset_tokens                                      password_reset_tokens[]
  system_settings                                            system_settings[]
  transport_contracts                                        transport_contracts[]
  trip_status_history                                        trip_status_history[]
  trips                                                      trips[]
  roles                                                      roles                   @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vendors                                                    vendors[]
  waybills                                                   waybills[]
