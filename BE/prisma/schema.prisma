model vendors {
  id                  BigInt                @id @default(autoincrement())
  company_name        String                @unique @db.VarChar(255)
  contact_person      String?               @db.VarChar(100)
  phone               String                @db.VarChar(15)
  truck_types         String?               @db.VarChar(50)
  approval_status     String                @default("Pending") @db.VarChar(20)
  approved_by         BigInt?
  approved_time       DateTime?             @db.Timestamptz(6)
  approval_notes      String?
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  uses_status_api     Boolean?              @default(false)
  api_key             String?               @db.VarChar(255)
  orders              orders[]
  transport_contracts transport_contracts[]
  users               users?                @relation(fields: [approved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model waybills {
  id                 BigInt   @id @default(autoincrement())
  trip_id            BigInt
  waybill_number     String   @unique @db.VarChar(20)
  issue_time         DateTime @default(now()) @db.Timestamptz(6)
  issued_by          BigInt?
  status             String   @default("Valid") @db.VarChar(20)
  trip_data_snapshot Json
  file_link          String?  @db.VarChar(255)
  users              users?   @relation(fields: [issued_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  trips              trips    @relation(fields: [trip_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
