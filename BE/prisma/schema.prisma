  customer_documents_customer_documents_checked_byTousers    customer_documents[]    @relation("customer_documents_checked_byTousers")
  customer_documents_customer_documents_required_byTousers   customer_documents[]    @relation("customer_documents_required_byTousers")
  customer_documents_customer_documents_uploaded_byTousers   customer_documents[]    @relation("customer_documents_uploaded_byTousers")
  customers                                                  customers[]
